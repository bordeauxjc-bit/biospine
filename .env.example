# Production site URL used for canonicals, sitemap, schema, and social cards.
# Replace this value after the custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://biospine.vercel.app

# Server-side Web3Forms key used by app/api/contact/route.ts.
WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# Analytics (optional; wire into app/layout.tsx when selected).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=biospine.example
