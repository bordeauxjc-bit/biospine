# Production site URL used for canonicals, sitemap, schema, and social cards.
# Replace this value after the custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://biospinemovedifferently.com

# Public form identifier issued by Web3Forms. Restrict it to the production
# domain in the Web3Forms dashboard.
WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# GA4 web-stream measurement ID. This value is public by design.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Web Analytics and Speed Insights are also loaded by app/layout.tsx.
