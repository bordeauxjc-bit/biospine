# Production site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://biospinehealth.com

# Google Analytics / Plausible (optional, wire in app/layout.tsx when ready)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=biospinehealth.com

# If deploying to Vercel (instead of Netlify), you'll need Resend for the contact form:
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=Biospinehealthandwellness@gmail.com
